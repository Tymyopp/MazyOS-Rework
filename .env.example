# ===== MazyOS — credenciais (copie para .env e preencha; .env NUNCA vai pro git) =====

# Fotos IA em carrosséis (opcional — só se usar foto gerada)
OPENAI_API_KEY=

# Publicação automática no Instagram + Facebook (/aprovar-post)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
SITE_URL=

# Opcionais (ver templates/ferramentas/catalogo.md)
GEMINI_API_KEY=
POSTFORME_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Conexão do Instagram por link (/conectar-instagram — ver docs/automacao-meta-setup.md)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8787/callback
# META_API_VERSION=v23.0

# Agendamento real (/agendar-posts — ver docs/agendamento.md)
# Opção A: Postiz (self-host)
POSTIZ_URL=
POSTIZ_API_KEY=
# Opção B: Post for Me
POSTFORME_API_KEY=

# TikTok (/postar-tiktok — ver docs/tiktok-setup.md)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
# TIKTOK_REFRESH_TOKEN=
