{
  "mcpServers": {
    "meta": {
      "command": "npx",
      "args": ["-y", "@oliverames/meta-mcp-server"],
      "env": {
        "META_ACCESS_TOKEN": "${META_PAGE_ACCESS_TOKEN}",
        "INSTAGRAM_USER_ID": "${META_IG_USER_ID}"
      }
    },
    "openwa": {
      "url": "http://localhost:2785/mcp",
      "headers": { "X-API-Key": "${OPENWA_API_KEY}" }
    }
  }
}
